NODE_ENV=development
PORT=3000

# ← حط connection string بتاعك من MongoDB Atlas هنا
DATABASE=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.xxxxx.mongodb.net/devflow?retryWrites=true&w=majority
